NODE_ENV=production

# Chave que o ManyChat manda no header X-Api-Key de cada External Request.
# Mínimo de 32 caracteres. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MANYCHAT_SECRET=

# Banco MySQL da Hostinger (hPanel > Bancos de dados > MySQL). A tabela é criada sozinha.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Token pessoal da Monday (o mesmo do painel / v16).
MONDAY_API_TOKEN=

# Opcional: link do quadro de leads, para o aviso do Telegram trazer o link do cadastro.
# Ex.: https://suaconta.monday.com/boards/1234567890
MONDAY_BOARD_URL=

# Opcional: títulos das colunas, se mudarem no quadro (padrões abaixo).
# MONDAY_TITULO_FAIXA=Faturamento Mensal
# MONDAY_TITULO_RESULTADO=Etapa do Funil
# MONDAY_TITULO_PROXIMO_CONTATO=Próximo Contato
# MONDAY_TITULO_ULTIMO_CONTATO=Último Contato
# OBS saiu do quadro em 03/11/2026 (opcional: se voltar, o status é gravado nela de novo).
# MONDAY_TITULO_OBS=OBS
# MONDAY_TITULO_DATA_CADASTRO=Data de Cadastro
# MONDAY_LABEL_QUALIFICADA=Quer reunião
# MONDAY_LABEL_FORA_DO_PERFIL=Fora do Perfil

# MONDAY_LABEL_REUNIAO_MARCADA=Reunião Marcada
# MONDAY_LABEL_RECUSOU=Não agendou
# MONDAY_LABEL_SEM_RESPOSTA=Não respondeu
# Coluna Grupo WhatsApp (opcional: "Está no grupo" / "Não está no grupo", gravadas pelo painel)
# MONDAY_TITULO_GRUPO=Grupo WhatsApp
# Etapa do Funil de quem tocou em "Sim, quero parar" (estava na coluna Grupo WhatsApp até 03/11/2026)
# MONDAY_LABEL_NAO_QUER_MENSAGENS=Não quer receber mensagens
# Quadro e colunas por ID (já vêm com os valores do quadro da Acme)
# MONDAY_BOARD_ID=1234567890
# MONDAY_PHONE_COLUMN_ID=phonenhzs51c9

# Quem recebe os avisos das aulas: todo o quadro, menos as Etapas do Funil abaixo (sem
# ciclo desde a v2.5.0). O Funil (origem) e a Data de Cadastro não importam.
# AULA_ETAPAS_EXCLUIDAS=Não quer receber mensagens,Deixou de ser cliente,Aguardando pagamento

# Bot do Telegram (o mesmo das recargas / relatório) e o grupo do pré-atendimento.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Endereço público deste app (o Calendly manda os agendamentos para cá).
PUBLIC_ORIGIN=https://assistente.example.com

# Calendly: link do evento que a Mani manda, token pessoal (Integrações > API e webhooks;
# permissões: users:read, scheduled_events:read, webhooks:read e webhooks:write)
# e o segredo que assina os avisos (32+ caracteres; gere como o MANYCHAT_SECRET).
CALENDLY_URL=
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SECRET=
# Opcional: pergunta do formulário do Calendly que recebe o WhatsApp pré-preenchido (a1 = 1ª pergunta).
CALENDLY_CAMPO_TELEFONE=
# Opcional: nome do evento da reunião no Calendly (ex.: Reunião com a equipe do consultor).
# Com ele, agendamentos de outros eventos da conta que não vieram pelo link da Mani são ignorados.
CALENDLY_EVENTO_NOME=

# Opcional (só no plano Pro pago do ManyChat): chave da API e ID do fluxo de lembrete, para o
# sistema disparar os lembretes às 10h. Sem elas, o próprio fluxo do ManyChat pede o lembrete
# em /manychat/lembrete (padrão).
MANYCHAT_API_KEY=
# Campo do usuário (Texto) com o WhatsApp copiado do campo do sistema (padrão: whatsapp_numero).
# MANYCHAT_CAMPO_WHATSAPP=whatsapp_numero
MANYCHAT_FLOW_LEMBRETE=

# Convite para o grupo pela Mani (botão no "Conferir grupo" do painel de inscritos):
# fluxo do ManyChat com o modelo convite_grupo_aula, data da turma atual (AAAA-MM-DD) e a
# chave que o painel usa para chamar este app (a mesma INTERNO_SECRET no painel; 32+ caracteres).
MANYCHAT_FLOW_CONVITE=
AULA_DATA=
# Horário da aula (Brasília): "20" ou "19:30". Vazio = 20h. Vai no campo do bot hora_aula e no e-mail.
# AULA_HORA=20
INTERNO_SECRET=

# Lembretes da aula no privado (3 dias antes, 1 dia antes e no dia, a partir das 10h) para a
# turma de AULA_DATA (AAAA-MM-DD). Fluxo vazio = aquele lembrete não sai.
# (AULA_INSCRICOES_DESDE e AULA_FUNIS_EXTRA não são mais usados desde a v2.0.0.)
MANYCHAT_FLOW_AULA_3DIAS=
# Convite para amiga (2 dias antes, 10h, para todos os inscritos; modelo de Marketing, envio único).
MANYCHAT_FLOW_AULA_AMIGA=
MANYCHAT_FLOW_AULA_AMANHA=
MANYCHAT_FLOW_AULA_HOJE=
# "Falta 1 hora" (19h do dia da aula, com o link): fluxo com o modelo aula_lembrete_1hora.
MANYCHAT_FLOW_AULA_1HORA=
# "A aula começou agora" (20h do dia da aula) com o link de acesso: fluxo com o modelo
# aula_comecou e o link da aula (vai no campo do bot link_aula). Troque o link a cada turma.
MANYCHAT_FLOW_AULA_AOVIVO=
AULA_LINK=

# E-mails de lembrete da aula mensal pelo Brevo (as lives NÃO recebem e-mail). Cada e-mail sai
# junto com o WhatsApp do mesmo lembrete, para o e-mail da inscrição na Monday, menos quem tem
# "Não quer receber mensagens". Chave: Brevo > SMTP e API > Chaves de API. Modelo: o número
# do modelo transacional (Brevo > Modelos), com {{ params.NOME }}, {{ params.DATA_AULA }} e
# {{ params.LINK_AULA }}. Modelo vazio = aquele e-mail não sai.
BREVO_API_KEY=
BREVO_MODELO_AULA_3DIAS=
BREVO_MODELO_AULA_AMANHA=
BREVO_MODELO_AULA_1HORA=
BREVO_MODELO_AULA_AOVIVO=
# Coluna de e-mail no quadro (padrão: a mesma que a API de inscrições grava).
# MONDAY_EMAIL_COLUMN_ID=emailhnvgrjbb
# Opcional: lembretes que pulam quem está no grupo (coluna Grupo WhatsApp), ex.: 3dias,amanha.
# Vazio (padrão): todos os lembretes vão para todos.
AULA_PULAR_NO_GRUPO=
# Opcional: horário (Brasília) dos lembretes do dia, como 18 ou 19:30; vazio = 10h.
AULA_HORA_3DIAS=
AULA_HORA_AMIGA=
AULA_HORA_AMANHA=

# Confirmação da reunião pelo WhatsApp quando a pessoa agenda no Calendly
# (fluxo do ManyChat com o modelo confirmacao_reuniao; usa o campo reuniao_texto). Vazio = não manda.
MANYCHAT_FLOW_CONFIRMACAO=

# Lembretes das lives (20h, YouTube, nas datas de LIVE_DATA): para todos os inscritos das aulas,
# menos quem marcou "Não quer receber mensagens". O link da live fica no campo do bot
# link_live (ManyChat). Vazio = desligado.
MANYCHAT_FLOW_LIVE_VESPERA=
MANYCHAT_FLOW_LIVE_1HORA=
MANYCHAT_FLOW_LIVE_COMECOU=
# Data da próxima live (ou várias, separadas por vírgula). Vazio = nenhum lembrete de live.
# Ex.: LIVE_DATA=2026-11-05   ou   LIVE_DATA=2026-11-05,2026-11-12
LIVE_DATA=
# Horário da véspera (dia anterior à live), como 19:30 (padrão).
LIVE_HORA_VESPERA=

# Disparo único (ex.: aviso do sorteio das mentorias): um modelo, uma vez, para o mesmo
# público dos avisos das aulas, no dia DISPARO_DATA a partir de DISPARO_HORA (padrão 20).
# Começa até 2 horas depois da hora marcada; o que sobrar na fila não sai depois de 4 horas.
# Sem fluxo ou sem data = desligado. Cada telefone recebe uma vez por data.
MANYCHAT_FLOW_DISPARO=
DISPARO_DATA=
DISPARO_HORA=

# Lembretes da reunião marcada no Calendly (vazio = não manda aquele aviso).
MANYCHAT_FLOW_REUNIAO_VESPERA=
MANYCHAT_FLOW_REUNIAO_DIA_CONFIRMAR=
MANYCHAT_FLOW_REUNIAO_DIA_CONFIRMADO=
MANYCHAT_FLOW_REUNIAO_REAGENDADA=
MANYCHAT_FLOW_REUNIAO_CANCELADA=
# Horários (Brasília): pedido de confirmação no dia anterior (dia de calendário, sem exceção
# para fim de semana nem feriado) e lembrete no dia.
# REUNIAO_HORA_VESPERA=13
# REUNIAO_HORA_DIA=8
# Reunião antes do horário do dia: lembrete sai estes minutos antes do início.
# REUNIAO_ANTECEDENCIA_MIN=120
# Aviso muito perto do agendamento não sai (minutos).
# REUNIAO_INTERVALO_MIN=60
# Agenda do consultor (Google Agenda): reuniões marcadas direto na agenda, sem Calendly, também
# recebem os lembretes. Conta de serviço do Google Cloud com a agenda compartilhada só para ver
# ("Ver todos os detalhes do evento"). GOOGLE_AGENDA_CHAVE = o arquivo JSON da chave em base64,
# numa linha só. Vazio = desligado. Eventos com uma palavra de GOOGLE_AGENDA_IGNORAR no título
# ficam de fora (ex.: as mentorias das sorteadas).
GOOGLE_AGENDA_CHAVE=
# GOOGLE_AGENDA_ID=consultor@example.com
# Desde a v2.9.0 o título não importa: entra quem está na Monday (telefone ou e-mail).
# Título com "Mentoria" vai para os lembretes das sorteadas.
# GOOGLE_AGENDA_IGNORAR=Mentoria
# Etiquetas da Etapa do Funil (padrões abaixo).
# MONDAY_LABEL_REUNIAO_CANCELADA=Reunião cancelada

# Sorteio semanal das mentorias (v2.7.0). Rodada = terça: aviso 12h30, inscrições até
# quarta 12h30, sorteio até 15h, lembretes quarta 19h e quinta 12h, prazo sexta 12h,
# "perdeu a vaga" sexta 15h. Sem SORTEIO_INICIO (uma terça, ex.: 2026-11-10), desligado.
SORTEIO_INICIO=
# Opcionais: vagas por semana (padrão 4), Etapas que tiram do sorteio (padrão: as 6 do
# documento do gestor) e os sites que podem enviar a inscrição (padrão: example.com).
SORTEIO_VAGAS=
SORTEIO_ETAPAS_EXCLUIDAS=
SORTEIO_ORIGENS=
MANYCHAT_FLOW_SORTEIO_AVISO=
MANYCHAT_FLOW_SORTEIO_SORTEADA=
MANYCHAT_FLOW_SORTEIO_LEMBRETE1=
MANYCHAT_FLOW_SORTEIO_LEMBRETE2=
MANYCHAT_FLOW_SORTEIO_PERDEU_VAGA=
MANYCHAT_FLOW_MENTORIA_VESPERA=
MANYCHAT_FLOW_MENTORIA_1HORA=
# Modelo sorteio_verificar_cadastro (v2.8.0): quem a página não acha (nem pelo telefone nem
# pelo e-mail) confere o e-mail pelo WhatsApp. Vazio = a página só avisa a equipe no Telegram.
MANYCHAT_FLOW_SORTEIO_VERIFICAR=
